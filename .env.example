# Copy to .env and fill in. All optional — app works in MOCK mode without keys.

# Data source: mock | free | rapidapi
#   mock  = demo data (no keys needed)
#   free  = Google Custom Search + Amazon PA-API (free tiers)
#   rapidapi = paid RapidAPI endpoints
DATA_SOURCE=mock

# ─── FREE mode credentials ──────────────────────────────────────────────
# Google Custom Search (free 100 queries/day)
# Create at: https://programmablesearchengine.google.com/
# Then get API key at: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=
GOOGLE_CX=

# Amazon PA-API (free with Amazon Associates account)
# Sign up: https://affiliate-program.amazon.in/
# Then generate credentials at: https://webservices.amazon.com/paapi5/documentation/
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Amazon affiliate tracking tag for scraper results (optional)
# e.g. princil-21 — appends ?tag=princil-21 to all Amazon.in product links
AMAZON_AFFILIATE_TAG=

# ─── PAID mode credentials (legacy) ─────────────────────────────────────
# RapidAPI (https://rapidapi.com) — used when DATA_SOURCE=rapidapi
RAPIDAPI_KEY=
RAPIDAPI_AMAZON_HOST=real-time-amazon-data.p.rapidapi.com
RAPIDAPI_FLIPKART_HOST=real-time-flipkart-api.p.rapidapi.com

# OpenAI for natural-language query parsing + deal ranking (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
